# Local dev: run `npm run env:sync` to pull Firebase web config into .env.local.
# Or copy this file to .env.local and paste values from Firebase Console.
VITE_FIREBASE_API_KEY=
# Use your Firebase auth domain until custom domain is live (e.g. rabbitholeapps.firebaseapp.com).
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Master admin — first login with this email is promoted to admin.
VITE_MASTER_ADMIN_EMAIL=

# reCAPTCHA v3 site key for Firebase App Check (web).
VITE_RECAPTCHA_SITE_KEY=

# Set to "true" to talk to local emulators
VITE_USE_EMULATORS=false

# Force local demo auth even if Firebase keys are present
# VITE_USE_DEMO=true
