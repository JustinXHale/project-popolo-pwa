rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isStaff() {
      return signedIn() && role() in ['admin', 'coach'];
    }

    match /headshots/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && (request.auth.uid == uid || isStaff())
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /docs/{refereeId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && (isStaff() || request.auth.uid == refereeId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /media/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow write: if signedIn()
        && (request.auth.uid == uid || isStaff())
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
